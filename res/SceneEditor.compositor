    }
}
workspace SceneEditorFramework/SceneToTextureWorkspace7
{
    connect_output SceneEditorFramework/SceneToTextureNode7 0
}

//Nothing draws the window itself any more: the scene goes to a texture and the
//imgui plugin's overlay workspace only adds the gui on top of what is already
//there. Without this the window would be left holding whatever the last frame
//left in it, which shows up as flickering behind the docking area.
compositor_node SceneEditorFramework/ClearWindowNode
{
    in 0 renderWindow

    target renderWindow
    {
        pass clear
        {
            colour_value 0.06 0.07 0.09 1
        }
    }
}

workspace SceneEditorFramework/ClearWindowWorkspace
{
    connect_output SceneEditorFramework/ClearWindowNode 0
}
