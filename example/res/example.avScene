                </mesh>
                <mesh name="S2B Child 1" mesh="lineBox">
                    <position x="5" y="0" z="0"/>
                    <scale x="0.9" y="0.9" z="0.9"/>
                </mesh>
                <mesh name="S2B Child 2" mesh="lineBox">
                    <position x="0" y="5" z="0"/>
                    <scale x="0.9" y="0.9" z="0.9"/>
