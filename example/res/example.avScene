            </empty>
            <empty name="Branch C">
                <position x="-15" y="0" z="0"/>
                <mesh name="Branch C Box" mesh="lineBox">
                    <scale x="1.5" y="1.5" z="1.5"/>
                </mesh>
                <mesh name="C Direct Child" mesh="lineBox">
                    <position x="5" y="0" z="0"/>
                    <scale x="0.9" y="0.9" z="0.9"/>
                </mesh>
            </empty>
        </empty>
        <empty name="Root Structure 2">
            <position x="0" y="0" z="20"/>
            <mesh name="Second Root Box" mesh="lineBox">
                <scale x="2" y="2" z="2"/>
            </mesh>
            <empty name="Structure 2 Branch A">
                <position x="12" y="0" z="0"/>
                <mesh name="S2A Box" mesh="lineBox">
                    <scale x="1.5" y="1.5" z="1.5"/>
                    <orientation x="-3.47645e-10" y="1.75014e-09" z="0.194832" w="0.980837"/>
                </mesh>
                <empty name="S2A Sub-level 1">
                    <position x="8" y="0" z="0"/>
