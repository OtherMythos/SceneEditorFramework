                <mesh name="Branch A Box" mesh="lineBox">
                    <scale x="1.5" y="1.5" z="1.5"/>
                </mesh>
                <empty name="Sub-branch A1">
                    <position x="8" y="0" z="0"/>
                    <mesh name="A1 Box" mesh="lineBox"/>
                    <mesh name="A1 Sibling" mesh="lineBox">
                        <position x="0" y="5" z="0"/>
                        <scale x="0.8" y="0.8" z="0.8"/>
                    </mesh>
                </empty>
                <empty name="Sub-branch A2">
                    <position x="8" y="8" z="0"/>
                    <mesh name="A2 Box" mesh="lineBox">
                        <scale x="1.2" y="1.2" z="1.2"/>
