                    <mesh name="A2 Child 1" mesh="lineBox">
                        <position x="5" y="0" z="0"/>
                        <scale x="0.9" y="0.9" z="0.9"/>
                    </mesh>
                    <mesh name="A2 Child 2" mesh="lineBox">
                        <position x="0" y="5" z="0"/>
                        <scale x="0.9" y="0.9" z="0.9"/>
                    </mesh>
                </empty>
            </empty>
            <empty name="Branch B">
                <position x="0" y="15" z="0"/>
                <mesh name="Branch B Box" mesh="lineBox">
                    <scale x="1.5" y="1.5" z="1.5"/>
                </mesh>
                <empty name="Sub-branch B1">
